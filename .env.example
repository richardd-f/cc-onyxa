# PostgreSQL: used by Prisma and the pg adapter.
DATABASE_URL="postgresql://postgres:password@localhost:5432/onyxa?schema=public"

# Session signing. Set a long, random value before running the application.
AUTH_SECRET="replace-with-a-long-random-secret"

# Retained OCR.Space/Gemini adapters; no scanner workflow is currently exposed.
OCR_SPACE_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
