generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum ReceiptStatus {
  PENDING
  PROCESSING
  NEEDS_REVIEW
  COMPLETED
  FAILED
}

enum TransactionSource {
  MANUAL
  RECEIPT
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  E_WALLET
  OTHER
  UNKNOWN
}

enum InsightType {
  SPENDING_INCREASE
  SPENDING_DECREASE
  RECURRING_HABIT
  CATEGORY_CONCENTRATION
  MERCHANT_CONCENTRATION
  UNUSUAL_ACTIVITY
  SAVING_OPPORTUNITY
}

enum ProcessingJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  currency      String    @default("USD")
  locale        String    @default("en-US")
  timezone      String    @default("UTC")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  transactions     Transaction[]
  receipts         Receipt[]
  categories       Category[]
  merchants        Merchant[]
  financialInsights FinancialInsight[]
  categoryRules    UserCategoryRule[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  slug        String
  description String?
  icon        String?
  color       String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  categoryRules UserCategoryRule[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([isSystem])
}

model Merchant {
  id             String   @id @default(cuid())
  userId         String
  normalizedName String
  displayName    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, normalizedName])
  @@index([userId])
}

model Receipt {
  id            String        @id @default(cuid())
  userId        String
  filename      String
  mimeType      String
  fileSize      Int
  storageKey    String
  fileUrl       String?       @db.Text
  checksum      String?
  status        ReceiptStatus @default(PENDING)
  ocrProvider   String?
  aiProvider    String?
  ocrText       String?       @db.Text
  extractedData Json?
  errorCode     String?
  errorMessage  String?
  attemptCount  Int           @default(0)
  uploadedAt    DateTime      @default(now())
  processedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction    Transaction?
  processingJobs ReceiptProcessingJob[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  merchantId    String?
  receiptId     String?           @unique
  categoryId    String?
  date          DateTime
  amount        Decimal           @db.Decimal(12, 2)
  currency      String            @default("USD")
  paymentMethod PaymentMethod     @default(UNKNOWN)
  description   String?
  notes         String?
  source        TransactionSource @default(MANUAL)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant    Merchant?         @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  receipt     Receipt?          @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items       TransactionItem[]

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, merchantId])
  @@index([userId, source])
}

model TransactionItem {
  id            String   @id @default(cuid())
  transactionId String
  name          String
  quantity      Decimal? @db.Decimal(10, 3)
  unitPrice     Decimal? @db.Decimal(12, 2)
  totalPrice    Decimal? @db.Decimal(12, 2)
  sku           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model FinancialInsight {
  id          String      @id @default(cuid())
  userId      String
  type        InsightType
  title       String
  description String      @db.Text
  evidence    Json
  periodStart DateTime?
  periodEnd   DateTime?
  isDismissed Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isDismissed])
}

model ReceiptProcessingJob {
  id             String              @id @default(cuid())
  receiptId      String
  status         ProcessingJobStatus @default(PENDING)
  stage          String?
  attemptCount   Int                 @default(0)
  idempotencyKey String              @unique
  errorInfo      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([status, createdAt])
}

model UserCategoryRule {
  id               String   @id @default(cuid())
  userId           String
  ruleType         String   @default("MERCHANT_EXACT")
  matchValue       String
  targetCategoryId String
  priority         Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetCategory Category @relation(fields: [targetCategoryId], references: [id], onDelete: Cascade)

  @@index([userId, matchValue])
}
